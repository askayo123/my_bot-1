                <image>
                    <width>640</width>
                    <height>480</height>
                </image>
            </depth_camera>
        </sensor>
                    <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>-->
    </gazebo>

</robot>